# Example dev environment file. Copy it to .env.dev (which is gitignored) and adjust.
#
#   Copy-Item .env.dev.example .env.dev
#
# run-dev.ps1 loads every KEY=VALUE line here into the environment before starting the app.

SPRING_PROFILES_ACTIVE=dev

# Dev-only throwaway signing key. Generate your own with:  openssl rand -base64 32
# It must decode to at least 256 bits (32 bytes) for HS256. Never reuse this in production.
JWT_SECRET=cGF3emFhci1kZXYtb25seS1zZWNyZXQta2V5LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9uLTAxMjM0NTY3ODk=
