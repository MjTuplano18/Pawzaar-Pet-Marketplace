# Example dev environment file. Copy it to .env.dev (which is gitignored) and adjust.
#
#   Copy-Item .env.dev.example .env.dev
#
# run-dev.ps1 loads every KEY=VALUE line here into the environment before starting the app.

SPRING_PROFILES_ACTIVE=dev

# Dev-only throwaway signing key. Generate your own with:  openssl rand -base64 32
# It must decode to at least 256 bits (32 bytes) for HS256. Never reuse this in production.
JWT_SECRET=cGF3emFhci1kZXYtb25seS1zZWNyZXQta2V5LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9uLTAxMjM0NTY3ODk=

# ── Image storage ─────────────────────────────────────────────────────────────
# Default is "local": uploads go to the ./uploads folder and need no cloud account.
# To store images in Supabase Storage instead, uncomment the block below and fill it in:
#   * url         - Project Settings > API > Project URL (no trailing slash)
#   * bucket      - Storage > a PRIVATE bucket you create, e.g. pawzaar-images
#   * service-key - Project Settings > API > service_role key (SECRET; server-side only)
# PAWZAAR_STORAGE_TYPE=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_BUCKET=pawzaar-images
# SUPABASE_SERVICE_KEY=<service-role-key>
