# Maven build output - regenerable, never commit (if `mvn clean` deletes it, git must not see it)
target/

# IntelliJ IDEA
.idea/
*.iml
out/

# VS Code
.vscode/

# OS noise
Thumbs.db
.DS_Store

# Logs
*.log

# Local environment overrides - may contain real secrets, never commit
.env
.env.*
application-local.yaml
application-local.yml

# application-prod.yaml is committed (it has no secrets, only ${ENV_VAR} references).
# If you ever create a local override with real values, name it application-local.yaml.
