<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.pawzaar</groupId>
	<artifactId>pawzaar-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<!-- JDK 23+ disabled implicit annotation processing in javac.
		     Lombok IS an annotation processor, so we must opt in explicitly,
		     otherwise @Getter/@Setter/@NoArgsConstructor are silently ignored
		     (mvn compiles, then every getter call fails with "cannot find symbol"). -->
		<maven.compiler.proc>full</maven.compiler.proc>
	</properties>
	<dependencies>
		<!-- Each spring-boot-starter-* is a curated bundle of jars.
		     Runtime: actuator (health/metrics), data-jpa (Hibernate + Spring Data),
		     flyway (SQL migrations), security, validation, webmvc (Tomcat + Jackson).
		     Test scope: the split *-test starters Spring Boot 4 uses for slice tests
		     (@WebMvcTest, @DataJpaTest, ...). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Lets us ISSUE and VERIFY JWTs with Spring Security's own support:
		     JwtEncoder / JwtDecoder (HMAC-SHA256) + BearerTokenAuthenticationFilter,
		     which also produces a proper 401 + WWW-Authenticate when no token is sent.
		     No hand-written token filters required. -->
		<!-- Boot 4 renamed this starter; the old spring-boot-starter-oauth2-resource-server
		     is deprecated in favor of the security- prefixed name. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- API documentation: auto-generates OpenAPI 3 spec + Swagger UI at /swagger-ui.html.
		     springdoc 3.x targets Spring Boot 4 (2.x targets Boot 3 / Framework 6). -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!--
					  `spring-boot:run` is a developer command, so it defaults to the local `dev`
					  profile (datasource on localhost:5433, the dev JWT secret, SQL logging).
					  Production runs the packaged jar with an explicit SPRING_PROFILES_ACTIVE=prod,
					  so this default never applies there. Override when needed:
					      ./mvnw spring-boot:run -Dspring-boot.run.profiles=prod
					-->
					<profiles>
						<profile>dev</profile>
					</profiles>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
					  Tests must be hermetic: no network, no cloud bucket, no credentials. A system
					  property OUTRANKS an OS environment variable in Spring's property order, so
					  this pins storage to the local disk even if the developer has
					  PAWZAAR_STORAGE_TYPE=supabase in their shell. (A value in
					  src/test/resources/application.yaml could NOT do this - env vars beat config
					  files, which is exactly the trap this avoids.)
					-->
					<systemPropertyVariables>
						<pawzaar.storage.type>local</pawzaar.storage.type>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
