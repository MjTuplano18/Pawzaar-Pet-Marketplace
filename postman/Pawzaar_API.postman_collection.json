{
  "info": {
    "_postman_id": "pawzaar-api-step10",
    "name": "Pawzaar API",
    "description": "Full test suite covering all endpoints through refresh tokens, CORS, CI and Docker.\n\nRun the folders in order. '05 Pets (write)' and '06 Refresh & logout' must run AFTER '04 Auth — login' because they rely on {{access_token}}, {{refresh_token}} and {{seed_token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",     "value": "http://localhost:8080", "type": "string" },
    { "key": "pet_id",       "value": "", "type": "string" },
    { "key": "created_pet_id", "value": "", "type": "string" },
    { "key": "user_id",      "value": "", "type": "string" },
    { "key": "user_email",   "value": "", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "old_refresh_token", "value": "", "type": "string" },
    { "key": "seed_token",   "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "GET health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 ok', () => pm.response.to.have.status(200));",
            "pm.test('body.status = ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/health" }
        }
      ]
    },
    {
      "name": "02 Pets (public read)",
      "item": [
        {
          "name": "GET pets — list (saves pet_id)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 public', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('PagedResponse shape: content array', () => pm.expect(b.content).to.be.an('array'));",
            "pm.test('PagedResponse shape: totalElements', () => pm.expect(b).to.have.property('totalElements'));",
            "pm.test('PagedResponse shape: page', ()         => pm.expect(b).to.have.property('page'));",
            "pm.test('PagedResponse shape: totalPages', ()   => pm.expect(b).to.have.property('totalPages'));",
            "pm.test('size capped at 50 even when 500 requested', () => pm.expect(b.content.length).to.be.at.most(50));",
            "if (b.content.length > 0) { pm.collectionVariables.set('pet_id', b.content[0].id); }"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets?size=500" }
        },
        {
          "name": "GET pets — summary has sex field",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const pets = pm.response.json().content;",
            "pm.test('at least one seed pet returned', () => pm.expect(pets.length).to.be.at.least(1));",
            "pm.test('summary has sex field', () => pm.expect(pets[0]).to.have.property('sex'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets" }
        },
        {
          "name": "GET pet by id — detail",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('has description', () => pm.expect(b).to.have.property('description'));",
            "pm.test('has sellerId',    () => pm.expect(b).to.have.property('sellerId'));",
            "pm.test('has sex',         () => pm.expect(b).to.have.property('sex'));",
            "pm.test('has updatedAt',   () => pm.expect(b).to.have.property('updatedAt'));",
            "pm.test('id matches pet_id', () => pm.expect(b.id).to.eql(pm.collectionVariables.get('pet_id')));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets/{{pet_id}}" }
        },
        {
          "name": "GET pet — 404 ProblemDetail",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404', () => pm.response.to.have.status(404));",
            "pm.test('problem+json', () => pm.response.to.have.header('Content-Type', /problem\\+json/));",
            "const b = pm.response.json();",
            "pm.test('title = Pet not found', () => pm.expect(b.title).to.eql('Pet not found'));",
            "pm.test('status = 404', () => pm.expect(b.status).to.eql(404));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets/00000000-0000-0000-0000-000000000000" }
        },
        {
          "name": "GET pet — 400 malformed UUID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 not 500', () => pm.response.to.have.status(400));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets/not-a-uuid" }
        },
        {
          "name": "GET pets — filter species=DOG",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const pets = pm.response.json().content;",
            "pm.test('at least one result', () => pm.expect(pets.length).to.be.at.least(1));",
            "pm.test('every result is a DOG', () => pets.every(p => p.species === 'DOG'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets?species=DOG&size=50" },
          "description": "Exact-match filter. Requires the dev seed data (2 DOG listings)."
        },
        {
          "name": "GET pets — filter breed contains (case-insensitive)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const pets = pm.response.json().content;",
            "pm.test('partial, case-insensitive match returns results', () => pm.expect(pets.length).to.be.at.least(1));",
            "pm.test('every breed contains the term', () => pets.every(p => (p.breed || '').toLowerCase().includes('retriever')));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets?breed=retriever" }
        },
        {
          "name": "GET pets — filter price range",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const pets = pm.response.json().content;",
            "pm.test('at least one result', () => pm.expect(pets.length).to.be.at.least(1));",
            "pm.test('every price is within [10000, 16000]', () => pets.every(p => Number(p.price) >= 10000 && Number(p.price) <= 16000));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets?minPrice=10000&maxPrice=16000" }
        },
        {
          "name": "GET pets — sort by price ascending",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const prices = pm.response.json().content.map(p => Number(p.price));",
            "pm.test('results are ascending by price', () => prices.every((v, i) => i === 0 || prices[i - 1] <= v));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets?sort=price&order=asc&size=50" }
        },
        {
          "name": "GET pets — 400 invalid sort (allowlist)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 not 500', () => pm.response.to.have.status(400));",
            "pm.test('problem+json', () => pm.response.to.have.header('Content-Type', /problem\\+json/));",
            "pm.test('title = Invalid sort parameter', () => pm.expect(pm.response.json().title).to.eql('Invalid sort parameter'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets?sort=password" },
          "description": "The sort field is an allowlist; anything else is rejected with 400 instead of an unhandled PropertyReferenceException (500)."
        }
      ]
    },
    {
      "name": "03 Auth — register",
      "item": [
        {
          "name": "POST register (201)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/users/'));",
            "const b = pm.response.json();",
            "pm.test('no password in response', () => pm.expect(b).to.not.have.property('password'));",
            "pm.test('no hash in response',     () => pm.expect(pm.response.text()).to.not.include('$2a$'));",
            "pm.test('role = USER',    () => pm.expect(b.role).to.eql('USER'));",
            "pm.test('verified = false', () => pm.expect(b.verified).to.eql(false));",
            "pm.collectionVariables.set('user_id',    b.id);",
            "pm.collectionVariables.set('user_email', b.email);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ana@email.com\",\n  \"password\": \"pawzaar123\",\n  \"displayName\": \"Ana Reyes\",\n  \"phone\": \"+639171234567\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/register",
            "description": "Change the email each run if 409 appears, or delete the row:\ndocker exec pawzaar-db psql -U pawzaar -d pawzaar -c \"DELETE FROM users WHERE email='ana@email.com';\""
          }
        },
        {
          "name": "POST register — 409 duplicate",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
            "pm.test('title = Email already registered', () => pm.expect(pm.response.json().title).to.eql('Email already registered'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ana@email.com\",\n  \"password\": \"pawzaar123\",\n  \"displayName\": \"Ana Reyes\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "POST register — 400 validation",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('title = Validation failed', () => pm.expect(pm.response.json().title).to.eql('Validation failed'));",
            "pm.test('errors array present', () => pm.expect(pm.response.json().errors).to.be.an('array').with.length.at.least(1));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"displayName\": \"\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/register"
          }
        }
      ]
    },
    {
      "name": "04 Auth — login",
      "item": [
        {
          "name": "POST login as ana (saves access_token)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('tokenType = Bearer',      () => pm.expect(b.tokenType).to.eql('Bearer'));",
            "pm.test('3 JWT segments',           () => pm.expect(b.accessToken.split('.')).to.have.lengthOf(3));",
            "pm.test('refreshToken present',     () => pm.expect(b.refreshToken).to.be.a('string').and.not.empty);",
            "pm.test('expiresInSeconds = 1800',  () => pm.expect(b.expiresInSeconds).to.eql(1800));",
            "pm.collectionVariables.set('access_token', b.accessToken);",
            "pm.collectionVariables.set('refresh_token', b.refreshToken);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ana@email.com\",\n  \"password\": \"pawzaar123\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "POST login as seed seller (saves seed_token)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('seed_token', pm.response.json().accessToken);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"seed@pawzaar.test\",\n  \"password\": \"pawzaar123\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "Logs in as the seed seller. Requires the dev profile so V3 seed data is present and the hash is a real BCrypt value."
          }
        },
        {
          "name": "POST login — 401 wrong password",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));",
            "pm.test('detail = Invalid email or password', () => pm.expect(pm.response.json().detail).to.eql('Invalid email or password'));",
            "pm.test('no email field in response (no enumeration)', () => pm.expect(pm.response.json()).to.not.have.property('email'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ana@email.com\",\n  \"password\": \"wrong\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "POST login — rate limited after repeated attempts (429)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 while tokens remain, 429 once exhausted', () => pm.expect([401, 429]).to.include(pm.response.code));",
            "if (pm.response.code === 429) {",
            "  pm.test('Retry-After header present',     () => pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.at.least(1));",
            "  pm.test('title = Too many requests',      () => pm.expect(pm.response.json().title).to.eql('Too many requests'));",
            "  pm.test('body reports retryAfterSeconds', () => pm.expect(pm.response.json().retryAfterSeconds).to.be.at.least(1));",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"seed@pawzaar.test\",\n  \"password\": \"wrong\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "description": "The auth endpoints are rate limited per client IP (token bucket, default 20/min). Run this request 25 times with the Collection Runner: the first 20 answer 401 and the rest answer 429 problem+json with a Retry-After header. A spoofed X-Forwarded-For does NOT bypass it, because pawzaar.rate-limit.trust-forwarded-for is false by default."
        },
        {
          "name": "GET protected — 401 no token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 (not 403)', () => pm.response.to.have.status(401));",
            "pm.test('WWW-Authenticate: Bearer', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/me/pets" }
        },
        {
          "name": "GET protected — passes with token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('not rejected by security (no 401/403)', () => pm.expect(pm.response.code).to.not.be.oneOf([401, 403]));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/me/pets"
          }
        }
      ]
    },
    {
      "name": "05 Pets (write — run after 04 Login)",
      "description": "Requires {{access_token}} (ana) and {{seed_token}} (seed seller) from folder 04.",
      "item": [
        {
          "name": "POST pet — 401 no token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 anonymous cannot create', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/pets"
          }
        },
        {
          "name": "POST pet — 400 validation (blank title)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 validation', () => pm.response.to.have.status(400));",
            "pm.test('title error listed', () => {",
            "    const errors = pm.response.json().errors;",
            "    pm.expect(errors.some(e => e.field === 'title')).to.be.true;",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"species\": \"DOG\",\n  \"ageMonths\": 3,\n  \"price\": 10000,\n  \"city\": \"Manila\",\n  \"province\": \"Metro Manila\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/pets"
          }
        },
        {
          "name": "POST pet — 201 create (saves created_pet_id)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/pets/'));",
            "pm.test('has updatedAt', () => pm.expect(b).to.have.property('updatedAt'));",
            "pm.test('sex = MALE',    () => pm.expect(b.sex).to.eql('MALE'));",
            "pm.test('status = ACTIVE', () => pm.expect(b.status).to.eql('ACTIVE'));",
            "pm.collectionVariables.set('created_pet_id', b.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Ana's test puppy\",\n  \"species\": \"DOG\",\n  \"breed\": \"Aspin\",\n  \"ageMonths\": 3,\n  \"price\": 500.00,\n  \"description\": \"Friendly and vaccinated.\",\n  \"city\": \"Quezon City\",\n  \"province\": \"Metro Manila\",\n  \"sex\": \"MALE\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/pets"
          }
        },
        {
          "name": "GET my pets — see the new listing",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('PagedResponse shape', () => pm.expect(b).to.have.all.keys('content','page','size','totalElements','totalPages'));",
            "pm.test('new listing appears', () => {",
            "    const found = b.content.some(p => p.id === pm.collectionVariables.get('created_pet_id'));",
            "    pm.expect(found).to.be.true;",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/me/pets"
          }
        },
        {
          "name": "PUT pet — 200 update by owner",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('title updated',    () => pm.expect(b.title).to.eql('Ana\\'s updated puppy'));",
            "pm.test('price updated',    () => pm.expect(b.price).to.eql(600));",
            "pm.test('updatedAt exists', () => pm.expect(b).to.have.property('updatedAt'));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Ana's updated puppy\",\n  \"breed\": \"Aspin\",\n  \"ageMonths\": 4,\n  \"price\": 600.00,\n  \"description\": \"Updated description.\",\n  \"city\": \"Quezon City\",\n  \"province\": \"Metro Manila\",\n  \"sex\": \"MALE\",\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/pets/{{created_pet_id}}"
          }
        },
        {
          "name": "PUT pet — 403 wrong owner (seed seller tries to edit ana's pet)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
            "pm.test('problem+json', () => pm.response.to.have.header('Content-Type', /problem\\+json/));",
            "pm.test('title = Access denied', () => pm.expect(pm.response.json().title).to.eql('Access denied'));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{seed_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Hacked title\",\n  \"ageMonths\": 1,\n  \"price\": 1.00,\n  \"city\": \"Nowhere\",\n  \"province\": \"Nowhere\",\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/pets/{{created_pet_id}}",
            "description": "The seed seller's token is valid but they do not own this pet. Proves the ownership check in PetService."
          }
        },
        {
          "name": "DELETE pet — 403 wrong owner",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{seed_token}}" }],
            "url": "{{base_url}}/api/v1/pets/{{created_pet_id}}"
          }
        },
        {
          "name": "DELETE pet — 204 by owner (soft-delete)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));",
            "pm.test('empty body', () => pm.expect(pm.response.text()).to.eql(''));"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/pets/{{created_pet_id}}"
          }
        },
        {
          "name": "GET deleted pet — 404 (now HIDDEN, invisible to public)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404 after soft-delete', () => pm.response.to.have.status(404));",
            "pm.test('title = Pet not found', () => pm.expect(pm.response.json().title).to.eql('Pet not found'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets/{{created_pet_id}}" }
        },
        {
          "name": "GET my pets — deleted pet still shows (HIDDEN, owner can see it)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "const deleted = b.content.find(p => p.id === pm.collectionVariables.get('created_pet_id'));",
            "pm.test('deleted pet appears in My Listings with HIDDEN status', () => {",
            "    pm.expect(deleted).to.not.be.undefined;",
            "    pm.expect(deleted.status).to.eql('HIDDEN');",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/me/pets"
          }
        }
      ]
    },
    {
      "name": "06 Listing images (run after 04 Login)",
      "description": "Uploads a cover image to a fresh listing, reads it back publicly, and deletes it. ATTACH a small JPEG/PNG/WebP file in the upload request's form-data (field name 'file'). Requires {{access_token}} from folder 04.",
      "item": [
        {
          "name": "POST pet — create a listing for image tests (saves image_pet_id)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('image_pet_id', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Image test pup\",\n  \"species\": \"DOG\",\n  \"breed\": \"Aspin\",\n  \"ageMonths\": 6,\n  \"price\": 1500.00,\n  \"description\": \"Listing created to demo image upload.\",\n  \"city\": \"Quezon City\",\n  \"province\": \"Metro Manila\",\n  \"sex\": \"MALE\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/pets"
          }
        },
        {
          "name": "POST image — 201 upload (attach a JPEG/PNG/WebP file)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 (pick a file in the body when running)', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) {",
            "  const b = pm.response.json();",
            "  pm.test('url points at the image bytes', () => pm.expect(b.url).to.contain('/images/'));",
            "  pm.collectionVariables.set('image_id', b.id);",
            "  pm.collectionVariables.set('image_url', b.url);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": { "mode": "formdata", "formdata": [
              { "key": "file", "type": "file", "src": null }
            ]},
            "url": "{{base_url}}/api/v1/pets/{{image_pet_id}}/images"
          },
          "description": "The server validates the ACTUAL bytes, not just the Content-Type: an unsupported type answers 415 and an oversized file 413, both as problem+json."
        },
        {
          "name": "GET image — 200 image/* (public, no token)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('served as an image', () => pm.expect(pm.response.headers.get('Content-Type')).to.contain('image/'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}{{image_url}}" }
        },
        {
          "name": "GET pet detail — 200 with images[]",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('images[] is present', () => pm.expect(pm.response.json().images).to.be.an('array'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/v1/pets/{{image_pet_id}}" }
        },
        {
          "name": "DELETE image — 204 by owner",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/pets/{{image_pet_id}}/images/{{image_id}}"
          }
        }
      ]
    },
    {
      "name": "07 Refresh & logout (run after 04 Login)",
      "description": "Proves refresh-token rotation: the old token stops working the moment a new one is issued, and logout revokes a token. Requires {{refresh_token}} from folder 04.",
      "item": [
        {
          "name": "POST refresh — 200 new pair (rotates)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('new accessToken is a JWT', () => pm.expect(b.accessToken.split('.')).to.have.lengthOf(3));",
            "pm.test('new refreshToken present', () => pm.expect(b.refreshToken).to.be.a('string'));",
            "const previous = pm.collectionVariables.get('refresh_token');",
            "pm.test('refresh token actually rotated', () => pm.expect(b.refreshToken).to.not.eql(previous));",
            "pm.collectionVariables.set('old_refresh_token', previous);",
            "pm.collectionVariables.set('refresh_token', b.refreshToken);",
            "pm.collectionVariables.set('access_token', b.accessToken);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "POST refresh — 401 reuse of the rotated token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));",
            "pm.test('problem+json', () => pm.response.to.have.header('Content-Type', /problem\\+json/));",
            "pm.test('title = Invalid refresh token', () => pm.expect(pm.response.json().title).to.eql('Invalid refresh token'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{old_refresh_token}}\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "POST logout — 204 revokes",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        },
        {
          "name": "POST refresh after logout — 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 revoked token rejected', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "POST refresh — 400 blank token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 validation', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"\"\n}", "options": { "raw": { "language": "json" }}},
            "url": "{{base_url}}/api/v1/auth/refresh"
          }
        }
      ]
    }
  ]
}
